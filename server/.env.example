PORT=4000
CLIENT_ORIGIN=http://localhost:5174
CLIENT_PUBLIC_URL=http://localhost:5174
DATABASE_URL=postgresql://postgres:password@localhost:5432/fms_engine

# Real email delivery (Node.js + Nodemailer)
# Development option for Google Workspace: smtp.gmail.com + a Google App Password.
# Production option: Google Workspace SMTP relay (smtp-relay.gmail.com) configured by an admin.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-authorized-mailbox@dinerofoodworks.com
SMTP_PASS=your-google-app-password
SMTP_FROM=your-authorized-mailbox@dinerofoodworks.com

# Optional phone/WhatsApp provider webhook
MESSAGING_WEBHOOK_URL=

# Google Workspace-only portal login
GOOGLE_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
ALLOWED_GOOGLE_DOMAIN=dinerofoodworks.com
SESSION_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false

# Shared secret used by the Google Form -> FMS Engine submission webhook (google-apps-script/)
FORM_WEBHOOK_SECRET=change-this-webhook-secret
